(portfolio_path) {
	redir /portfolio /portfolio/ 308
	handle_path /portfolio/* {
		route {
			@entry path / /demo /demo/*
			redir @entry /portfolio/login 302

			@workspaceFiles path /api/media/upload /api/uploads/*/import
			request_body @workspaceFiles {
				max_size 21MB
			}
			@mediaContent path /api/media/*/content
			header @mediaContent Content-Security-Policy "sandbox; default-src 'none'"
			@otherApi {
				path /api /api/*
				not {
					path /api/dashboard/summary /api/operations/settings /api/settings/campaign-builder-guardrails /api/google-ads/capabilities /api/accounts/*/catalog /api/jobs /api/media/*/content
					path /api/ai/capabilities /api/ai/preferences /api/ai/source-registry /api/ai/conversations /api/ai/drafts /api/ai/reports /api/ai/usage /api/ai/geo-profiles /api/ai/geo-overrides /api/ai/metric-source-mappings
					path /api/uploads /api/uploads/* /api/templates /api/templates/* /api/plans /api/plans/* /api/schedules /api/schedules/* /api/launch-batches /api/launch-batches/* /api/campaign-instances/* /api/launch-groups /api/launch-groups/*
					path /api/media /api/media/upload /api/media/youtube /api/media/*/youtube-upload
					path /api/health /api/ready /api/version /api/setup/status
					path /api/auth/portfolio-link /api/auth/portfolio-guest /api/auth/me /api/auth/logout
					path /api/control-center/* /api/audit /api/accounts /api/google-connections
					path /api/operations/statistics /api/operations/statistics/sync
					path /api/operations/finance /api/operations/finance/google-billing/*
					path /api/operations/moderation /api/operations/moderation/sync
					path /api/operations/alerts /api/operations/alerts/*
				}
			}
			respond @otherApi 404
			@writeOutsidePortfolio {
				path /api/dashboard/summary /api/operations/settings /api/settings/campaign-builder-guardrails /api/google-ads/capabilities /api/accounts/*/catalog /api/jobs /api/media/*/content
				path /api/ai/capabilities /api/ai/preferences /api/ai/source-registry /api/ai/conversations /api/ai/drafts /api/ai/reports /api/ai/usage /api/ai/geo-profiles /api/ai/geo-overrides /api/ai/metric-source-mappings
				path /api/accounts /api/google-connections /api/operations/finance
				path /api/control-center/sync /api/control-center/sync/*
				path /api/operations/statistics/sync /api/operations/moderation/sync
				not method GET HEAD
			}
			respond @writeOutsidePortfolio 405

			reverse_proxy axyro-portfolio-ingress:80 {
				header_up Host axyro.tech
				header_up Cookie "axyro_portfolio_session={cookie.axyro_portfolio_session}"
				header_up -Authorization
			}
		}
	}
}
