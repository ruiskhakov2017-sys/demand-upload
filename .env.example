APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost
# Non-secret deployment metadata, populated automatically by the release workflow.
APP_VERSION_SHA=development
APP_RELEASE_TAG=
APP_DEPLOYED_AT=
APP_ENCRYPTION_KEY=change-me-generate-a-long-random-secret-before-production
SETUP_TOKEN=change-me-one-time-setup-token
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://dgu:dgu@postgres:5432/dgu
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost","http://localhost:5173","http://127.0.0.1:5173"]
# Restrict this to the production domain/IP and localhost tunnel endpoints.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Production reverse-proxy defaults stay local until a real domain is configured.
DGU_HTTP_BIND=127.0.0.1:8080
DGU_HTTPS_BIND=127.0.0.1:8443
DGU_HTTPS_UDP_BIND=127.0.0.1:8443
DGU_SITE_ADDRESS=http://localhost
DGU_WWW_SITE_ADDRESS=http://www.localhost
DGU_CANONICAL_URL=http://localhost
STORAGE_ROOT=/var/lib/dgu/storage
GOOGLE_ADS_API_VERSION=v24.2
# Legacy compatibility setting only. Production mutate remains hard-blocked in code.
CONTROL_CENTER_LIVE_ACTIONS_ENABLED=false
# Internal planning estimate only; Google does not expose an official remaining-quota counter.
CONTROL_CENTER_DAILY_OPERATION_LIMIT=15000

# AI analyst. The OpenAI key is backend-only and is never returned to the browser.
OPENAI_API_KEY=
AI_ENABLED=true
# Emergency stop for all model runs. Local history remains readable.
AI_KILL_SWITCH=false
AI_PRODUCTION_READ_ENABLED=false
AI_PRODUCTION_ACTIONS_ENABLED=false
AI_PAUSE_ACTIONS_ENABLED=false
AI_ENABLE_ACTIONS_ENABLED=false
AI_BUDGET_ACTIONS_ENABLED=false
AI_DEMAND_GEN_ACTIONS_ENABLED=false
AI_LIVE_RULES_ENABLED=false
AI_MAX_MODEL_TURNS=4
AI_MAX_READ_TOOL_CALLS=6
AI_MAX_DRAFT_TOOL_CALLS=1
AI_MAX_ROWS_PER_TOOL=100
AI_MAX_DATE_RANGE_DAYS=90
AI_INTERACTIVE_TIMEOUT_SECONDS=60
AI_RETENTION_DAYS=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=60
AI_MAX_CONCURRENT_RUNS=2
AI_GLOBAL_MAX_CONCURRENT_RUNS=8
AI_DAILY_SOFT_BUDGET_USD=5
AI_DAILY_HARD_BUDGET_USD=10
AI_MONTHLY_HARD_BUDGET_USD=100
AI_USER_DAILY_HARD_BUDGET_USD=5
AI_USER_MONTHLY_HARD_BUDGET_USD=50
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300
AI_VOICE_MAX_SECONDS=60
AI_VOICE_MAX_BYTES=10485760
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional backend-only domain reputation providers. Never expose these keys to the frontend.
WEB_RISK_ENABLED=false
WEB_RISK_API_KEY=
SPAMHAUS_DQS_ENABLED=false
SPAMHAUS_DQS_KEY=
IPQS_ENABLED=false
IPQS_API_KEY=
# Keep monitor until Google Web Risk and Spamhaus DQS are both configured; then use block.
DOMAIN_REPUTATION_ENFORCEMENT=monitor

# Opt-in only for a deliberate run against the isolated Google Ads test hierarchy.
RUN_GOOGLE_TEST_INTEGRATION=0

POSTGRES_DB=dgu
POSTGRES_USER=dgu
POSTGRES_PASSWORD=dgu
